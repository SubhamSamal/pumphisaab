# Copy this file to .env (same folder) and paste the two values from
# Supabase › Project Settings › API. Both are public values, safe in the app.
# The service role key must NEVER go here (CLAUDE.md hard rule 11).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-public-key-here
